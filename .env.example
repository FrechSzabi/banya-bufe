# Másold .env néven, és töltsd ki.
# Az admin felület (/admin) jelszava
ADMIN_PASSWORD=
# Hosszú véletlen szöveg a belépési sütik aláírásához, pl.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PORT=3001
# Az SQLite adatbázis helye (alapértelmezés: data/orders.db)
# DB_PATH=
# Reverse proxy (nginx stb.) mögött: 1
# TRUST_PROXY=1
